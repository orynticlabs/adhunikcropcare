generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OryCMSRole {
  id    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String       @unique
  users OryCMSUser[]

  @@map("orycms_roles")
}

model OryCMSUser {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String
  passwordHash     String?
  status           String                  @default("active")
  roleId           String?                 @db.Uuid
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?               @db.Timestamptz(6)
  fullName         String?
  mobileNumber     String?
  profilePhoto     String?
  username         String?
  emailVerified    Boolean                 @default(false)
  invited          Boolean                 @default(false)
  lastInvitedAt    DateTime?               @db.Timestamptz(6)
  lastLoginAt      DateTime?               @db.Timestamptz(6)
  role             OryCMSRole?             @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions         OryCMSSession[]
  invitationTokens OryCMSInvitationToken[]

  @@index([status], map: "orycms_users_status_idx")
  @@index([deletedAt], map: "orycms_users_deleted_at_idx")
  @@map("orycms_users")
}

model OryCMSInvitationToken {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String     @db.Uuid
  tokenHash        String     @unique
  expiresAt        DateTime   @db.Timestamptz(6)
  used             Boolean    @default(false)
  invitedByAdminId String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  user             OryCMSUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "orycms_invitation_tokens_user_id_idx")
  @@index([expiresAt], map: "orycms_invitation_tokens_expires_at_idx")
  @@map("orycms_invitation_tokens")
}

model OryCMSAdminAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId      String?  @db.Uuid
  adminEmail   String?
  targetUserId String?  @db.Uuid
  action       String
  ipAddress    String?
  details      Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([adminId], map: "orycms_admin_audit_logs_admin_id_idx")
  @@index([targetUserId], map: "orycms_admin_audit_logs_target_user_id_idx")
  @@index([createdAt], map: "orycms_admin_audit_logs_created_at_idx")
  @@map("orycms_admin_audit_logs")
}

model OryCMSSession {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @db.Uuid
  tokenHash String     @unique
  expiresAt DateTime   @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  user      OryCMSUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "orycms_sessions_user_id_idx")
  @@map("orycms_sessions")
}

model OryCMSMediaAsset {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId          String   @unique @map("asset_id")
  publicId         String   @unique @map("public_id")
  secureUrl        String   @map("secure_url")
  width            Int?
  height           Int?
  format           String
  bytes            Int
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  originalFilename String?  @map("original_filename")
  resourceType     String   @default("image") @map("resource_type")

  @@index([createdAt], map: "orycms_media_assets_created_at_idx")
  @@map("orycms_media_assets")
}

model OryCMSProduct {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String
  shortDescription String    @map("short_description")
  fullDescription  String?   @map("full_description")
  specifications   String?   @map("specifications")
  howToUse         String?   @map("how_to_use")
  shippingReturns  String?   @map("shipping_returns")
  category         String
  brand            String?
  sku              String?
  price            Decimal   @db.Decimal(12, 2)
  salePrice        Decimal?  @map("sale_price") @db.Decimal(12, 2)
  packSizes        Json      @default("[]") @map("pack_sizes")
  stockQuantity    Int       @map("stock_quantity")
  unit             String
  status           String    @default("draft")
  featured         Boolean   @default(false)
  images           Json      @default("[]")
  tags             Json      @default("[]")
  metaTitle        String?   @map("meta_title")
  metaDescription  String?   @map("meta_description")
  verifyDescription String?   @map("verify_description")
  verifyImage       Json?     @map("verify_image")
  mfgDate           DateTime? @map("mfg_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  packTiming        String?   @map("pack_timing")
  packDate          DateTime? @map("pack_date") @db.Date
  supervisorName    String?   @map("supervisor_name")
  contractorName    String?   @map("contractor_name")
  literature        String?
  msds              String?
  license           String?
  cir               String?
  eprNumber         String?   @map("epr_number")
  plasticCategory   String?   @map("plastic_category")
  leafletInfo       String?   @map("leaflet_info")
  uin               String?   @unique
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([status], map: "orycms_products_status_idx")
  @@index([category], map: "orycms_products_category_idx")
  @@index([deletedAt], map: "orycms_products_deleted_at_idx")
  @@map("orycms_products")
}

model OryCMSCategory {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String           @unique
  parentId        String?          @map("parent_id") @db.Uuid
  image           Json?
  displayOrder    Int              @default(0) @map("display_order")
  status          String           @default("active")
  metaTitle       String?          @map("meta_title")
  metaDescription String?          @map("meta_description")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  parent          OryCMSCategory?  @relation("OryCMSCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children        OryCMSCategory[] @relation("OryCMSCategoryHierarchy")

  @@index([parentId], map: "orycms_categories_parent_id_idx")
  @@index([status], map: "orycms_categories_status_idx")
  @@index([deletedAt], map: "orycms_categories_deleted_at_idx")
  @@map("orycms_categories")
}

model OryCMSCertificate {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  issuingAuthority  String    @map("issuing_authority")
  certificateNumber String?   @map("certificate_number")
  description       String?
  image             Json?
  documentUrl       String?   @map("document_url")
  issuedOn          DateTime? @map("issued_on") @db.Date
  expiresOn         DateTime? @map("expires_on") @db.Date
  status            String    @default("draft")
  displayOrder      Int       @default(0) @map("display_order")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([status, displayOrder], map: "orycms_certificates_status_display_order_idx")
  @@index([deletedAt], map: "orycms_certificates_deleted_at_idx")
  @@map("orycms_certificates")
}

model OryCMSReelVideo {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  videoUrl     String    @map("video_url")
  posterUrl    String?   @map("poster_url")
  assetId      String?   @map("asset_id")
  publicId     String    @map("public_id")
  format       String
  bytes        Int       @default(0)
  status       String    @default("published")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([status, displayOrder], map: "orycms_reel_videos_status_display_order_idx")
  @@index([deletedAt], map: "orycms_reel_videos_deleted_at_idx")
  @@map("orycms_reel_videos")
}

model OryCMSFaq {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question     String
  answer       String
  displayOrder Int       @default(0) @map("display_order")
  status       String    @default("published")
  category     String?   @default("General")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([status, displayOrder], map: "orycms_faqs_status_display_order_idx")
  @@index([deletedAt], map: "orycms_faqs_deleted_at_idx")
  @@map("orycms_faqs")
}

model OryCMSInventoryEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  type      String
  quantity  Int      @default(0)
  reason    String?
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId], map: "orycms_inventory_events_product_id_idx")
  @@index([createdAt], map: "orycms_inventory_events_created_at_idx")
  @@map("orycms_inventory_events")
}

model StorefrontUser {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phone           String?
  passwordHash    String    @map("password_hash")
  avatar          String?
  defaultAddress  Json?     @map("default_address")
  status          String    @default("active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reviews         StorefrontProductReview[]

  @@index([status], map: "storefront_users_status_idx")
  @@index([deletedAt], map: "storefront_users_deleted_at_idx")
  @@map("storefront_users")
}

model StorefrontProductReview {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productSlug String         @map("product_slug")
  userId      String         @map("user_id") @db.Uuid
  user        StorefrontUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  title       String
  comment     String
  verified    Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productSlug, createdAt], map: "storefront_product_reviews_product_slug_created_at_idx")
  @@index([userId], map: "storefront_product_reviews_user_id_idx")
  @@map("storefront_product_reviews")
}

model StorefrontRefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "storefront_refresh_tokens_user_id_idx")
  @@map("storefront_refresh_tokens")
}

model StorefrontAuthToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  type      String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "storefront_auth_tokens_user_id_idx")
  @@map("storefront_auth_tokens")
}

model StorefrontSignupOtp {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String
  otpHash               String    @map("otp_hash")
  verificationTokenHash String?   @unique @map("verification_token_hash")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz(6)
  consumedAt            DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts              Int       @default(0)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt], map: "storefront_signup_otps_email_created_at_idx")
  @@index([expiresAt], map: "storefront_signup_otps_expires_at_idx")
  @@map("storefront_signup_otps")
}

model StorefrontOrder {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  number               String    @unique
  status               String    @default("processing")
  paymentStatus        String    @default("pending") @map("payment_status")
  paymentMethod        String    @default("cash_on_delivery") @map("payment_method")
  razorpayOrderId      String?   @map("razorpay_order_id")
  razorpayPaymentId    String?   @map("razorpay_payment_id")
  razorpaySignature    String?   @map("razorpay_signature")
  contact              Json?
  shippingAddress      Json?     @map("shipping_address")
  deliveryMethod       String?   @map("delivery_method")
  subtotal             Decimal   @default(0) @db.Decimal(12, 2)
  shippingTotal        Decimal   @default(0) @map("shipping_total") @db.Decimal(12, 2)
  discountTotal        Decimal   @default(0) @map("discount_total") @db.Decimal(12, 2)
  invoiceNumber        String?   @map("invoice_number")
  refundStatus         String    @default("none") @map("refund_status")
  shiprocketStatus     String?   @map("shiprocket_status")
  confirmedAt          DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedByAdminId   String?   @map("confirmed_by_admin_id") @db.Uuid
  confirmedByAdminEmail String?  @map("confirmed_by_admin_email")
  packedAt             DateTime? @map("packed_at") @db.Timestamptz(6)
  packedByAdminId      String?   @map("packed_by_admin_id") @db.Uuid
  packedByAdminEmail   String?   @map("packed_by_admin_email")
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(6)
  reservationExpiresAt DateTime? @map("reservation_expires_at") @db.Timestamptz(6)
  stockReleasedAt      DateTime? @map("stock_released_at") @db.Timestamptz(6)
  paymentTimeline      Json      @default("[]") @map("payment_timeline")
  tracking             String?
  invoiceUrl           String?   @map("invoice_url")
  items                Json      @default("[]")
  total                Decimal   @default(0) @db.Decimal(12, 2)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "storefront_orders_user_id_idx")
  @@index([createdAt], map: "storefront_orders_created_at_idx")
  @@index([confirmedAt], map: "storefront_orders_confirmed_at_idx")
  @@index([packedAt], map: "storefront_orders_packed_at_idx")
  @@map("storefront_orders")
}

model StorefrontPaymentTransaction {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  provider          String   @default("razorpay")
  event             String
  status            String
  amount            Decimal? @db.Decimal(12, 2)
  razorpayOrderId   String?  @map("razorpay_order_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  razorpayRefundId  String?  @map("razorpay_refund_id")
  rawPayload        Json?    @map("raw_payload")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId], map: "storefront_payment_transactions_order_id_idx")
  @@map("storefront_payment_transactions")
}

model StorefrontIdempotencyKey {
  key       String   @id
  userId    String   @map("user_id") @db.Uuid
  endpoint  String
  orderId   String?  @map("order_id") @db.Uuid
  response  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("storefront_idempotency_keys")
}

model RazorpayPayment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razorpayPaymentId String    @unique @map("razorpay_payment_id")
  razorpayOrderId   String?   @map("razorpay_order_id")
  orderId           String?   @map("order_id") @db.Uuid
  orderNumber       String?   @map("order_number")
  customerName      String?   @map("customer_name")
  amount            Decimal   @default(0) @db.Decimal(14, 2)
  amountRefunded    Decimal   @default(0) @map("amount_refunded") @db.Decimal(14, 2)
  currency          String    @default("INR")
  status            String
  method            String?
  captured          Boolean   @default(false)
  email             String?
  contact           String?
  fee               Decimal?  @db.Decimal(14, 2)
  tax               Decimal?  @db.Decimal(14, 2)
  refundStatus      String?   @map("refund_status")
  international     Boolean   @default(false)
  notes             Json?
  raw               Json?
  createdAtRzp      DateTime? @map("created_at_rzp") @db.Timestamptz(6)
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orderId], map: "razorpay_payments_order_id_idx")
  @@index([status], map: "razorpay_payments_status_idx")
  @@index([method], map: "razorpay_payments_method_idx")
  @@index([createdAtRzp], map: "razorpay_payments_created_at_rzp_idx")
  @@map("razorpay_payments")
}

model RazorpayRefund {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razorpayRefundId  String    @unique @map("razorpay_refund_id")
  razorpayPaymentId String    @map("razorpay_payment_id")
  orderId           String?   @map("order_id") @db.Uuid
  amount            Decimal   @default(0) @db.Decimal(14, 2)
  currency          String    @default("INR")
  status            String
  speedProcessed    String?   @map("speed_processed")
  reason            String?
  receipt           String?
  notes             Json?
  raw               Json?
  createdAtRzp      DateTime? @map("created_at_rzp") @db.Timestamptz(6)
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([razorpayPaymentId], map: "razorpay_refunds_payment_id_idx")
  @@index([status], map: "razorpay_refunds_status_idx")
  @@map("razorpay_refunds")
}

model RazorpaySettlement {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razorpaySettlementId String    @unique @map("razorpay_settlement_id")
  amount               Decimal   @default(0) @db.Decimal(14, 2)
  fees                 Decimal   @default(0) @db.Decimal(14, 2)
  tax                  Decimal   @default(0) @db.Decimal(14, 2)
  status               String
  settled              Boolean   @default(false)
  utr                  String?
  raw                  Json?
  createdAtRzp         DateTime? @map("created_at_rzp") @db.Timestamptz(6)
  syncedAt             DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status], map: "razorpay_settlements_status_idx")
  @@index([createdAtRzp], map: "razorpay_settlements_created_at_rzp_idx")
  @@map("razorpay_settlements")
}

model RazorpayWebhookLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event           String
  razorpayEventId String?  @map("razorpay_event_id")
  signatureValid  Boolean  @default(false) @map("signature_valid")
  status          String   @default("received")
  retryCount      Int      @default(0) @map("retry_count")
  error           String?
  payload         Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([event], map: "razorpay_webhook_logs_event_idx")
  @@index([createdAt], map: "razorpay_webhook_logs_created_at_idx")
  @@map("razorpay_webhook_logs")
}

model OryCMSPaymentAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  adminEmail String?  @map("admin_email")
  action     String
  paymentId  String?  @map("payment_id")
  refundId   String?  @map("refund_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([paymentId], map: "orycms_payment_audit_logs_payment_id_idx")
  @@index([createdAt], map: "orycms_payment_audit_logs_created_at_idx")
  @@map("orycms_payment_audit_logs")
}

model OryCMSNotification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String
  title      String
  message    String
  entityId   String?  @map("entity_id")
  entityType String?  @map("entity_type")
  targetUrl  String   @map("target_url")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([type, entityType, entityId, title], map: "orycms_notifications_dedupe_key")
  @@index([isRead, createdAt], map: "orycms_notifications_is_read_created_at_idx")
  @@map("orycms_notifications")
}

model StorefrontEmailLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  type       String
  recipient  String
  providerId String?  @map("provider_id")
  status     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orderId, type])
  @@map("storefront_email_logs")
}

model StorefrontEmailPreference {
  userId        String   @id @map("user_id") @db.Uuid
  disabledTypes String[] @default([]) @map("disabled_types")
