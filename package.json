{
  "name": "adhunikcropcare",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <27"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "predev": "npm run check:node",
    "dev": "npm run clean && next dev --webpack",
    "prebuild": "npm run check:node",
    "build": "npm run clean && npm run prisma:migrate && prisma generate && next build --webpack",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "prestart": "npm run check:node",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/prisma-migrate-deploy.mjs",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@ory-cms/core": "^0.1.3",
    "@ory-cms/next": "^0.1.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.63.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-table-cell": "^3.28.0",
    "@tiptap/extension-table-header": "^3.28.0",
    "@tiptap/extension-table-row": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "init": "^0.1.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.6",
    "shadcn": "^4.13.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp": true,
    "@img/sharp-darwin-arm64": true,
    "@img/sharp-darwin-x64": true,
    "@img/sharp-linux-arm64": true,
    "@img/sharp-linux-x64": true,
    "esbuild": true,
    "@esbuild/darwin-arm64": true,
    "@esbuild/darwin-x64": true,
    "@esbuild/linux-arm64": true,
    "@esbuild/linux-x64": true,
    "lightningcss": true,
    "lightningcss-darwin-arm64": true,
    "lightningcss-darwin-x64": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "@sentry/cli@2.58.6": true
