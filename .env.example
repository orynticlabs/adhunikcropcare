# NeonDB
DATABASE_URL=

# Next.js public URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Sentry — DSN (public key safe to expose in client bundles)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Sentry — source map upload (get these from sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudnary — get these from cloudinary.com → Settings → Upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ORYCMS_FOLDER=
ORYCMS_DATABASE_URL=

# Razorpay — get these from razorpay.com → Settings → API Keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STOCK_RESERVATION_MINUTES=

# Razorpay — test keys (for development only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STOCK_RESERVATION_MINUTES=

# Optional email sending via Resend
RESEND_API_KEY=...
ORDER_EMAIL_FROM=orders@yourdomain.com

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
SMTP_GMAIL_USER=
SMTP_GMAIL_APP_PASSWORD=
SMTP_EMAIL_FROM=
SMTP_ADMIN_EMAIL=
EMAIL_UNSUBSCRIBE_SECRET=