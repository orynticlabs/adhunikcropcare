# NeonDB pooled connections (application runtime)
DATABASE_URL=
ORYCMS_DATABASE_URL=

# NeonDB direct/non-pooler connection (Prisma migrations only)
# Use the Neon hostname without "-pooler" and set sslmode=verify-full.
DIRECT_DATABASE_URL=

# Next.js public URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Storefront footer company details
NEXT_PUBLIC_COMPANY_EMAIL=support@adhunikcropcare.com
NEXT_PUBLIC_COMPANY_PHONE=+919205762766
NEXT_PUBLIC_COMPANY_ADDRESS=India

# Storefront footer social media links (leave blank to hide a platform)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Storefront customer authentication (required in production)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STOREFRONT_AUTH_SECRET=

# Sentry — DSN (public key safe to expose in client bundles)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DEBUG=false
SENTRY_DEBUG=false
SENTRY_TEST_TOKEN=

# Sentry — source map upload (get these from sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudinary — get these from cloudinary.com → Settings → Upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary Upload Folders (by asset type & feature)
CLOUDINARY_ORYCMS_PRODUCTS_FOLDER=adhunik/orycms/images/products
CLOUDINARY_ORYCMS_CERTIFICATES_FOLDER=adhunik/orycms/images/certificates
CLOUDINARY_ORYCMS_CATEGORIES_FOLDER=adhunik/orycms/images/categories
CLOUDINARY_ORYCMS_PROFILES_FOLDER=adhunik/orycms/images/profiles
CLOUDINARY_ORYCMS_REELS_FOLDER=adhunik/orycms/videos/reels
CLOUDINARY_ORYCMS_IMAGES_FOLDER=adhunik/orycms/images/general
CLOUDINARY_ORYCMS_VIDEOS_FOLDER=adhunik/orycms/videos/general
CLOUDINARY_ORYCMS_ASSETS_FOLDER=adhunik/orycms/assets/general
CLOUDINARY_ORYCMS_FOLDER=adhunik/orycms

# Razorpay — get these from razorpay.com → Settings → API Keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STOCK_RESERVATION_MINUTES=

# Razorpay — test keys (for development only)
RAZORPAY_KEY_ID=..
RAZORPAY_KEY_SECRET=..
RAZORPAY_WEBHOOK_SECRET=..
STOCK_RESERVATION_MINUTES=..

# Email used for order-related emails
ORDER_EMAIL_FROM=notifications@adhunikcropcare.com

# SMTP Configuration
# For GoDaddy Workspace / Secureserver Email:
#   SMTP_HOST=smtpout.secureserver.net
#   SMTP_PORT=465 (or 587 / 3535)
# For GoDaddy Microsoft 365 Email:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=notifications@adhunikcropcare.com
SMTP_PASSWORD=

# Sender & Reply-To information
SMTP_EMAIL_FROM="Adhunik Crop Care <notifications@adhunikcropcare.com>"
SMTP_REPLY_TO=noreply@adhunikcropcare.com

# Admin email to receive copies of admin notifications
SMTP_ADMIN_EMAIL=ishan.gupta@adhunikcropcare.com

# Generate a random secret for unsubscribe links
EMAIL_UNSUBSCRIBE_SECRET=



# Shiprocket shipping integration
# API login (email or mobile number) + password are entered in OryCMS → Settings → Shiprocket
# and stored encrypted in the database. These env vars cover encryption + webhook auth only.
# Generate the key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SHIPROCKET_ENCRYPTION_KEY=
# Shared secret set as the webhook token in the Shiprocket dashboard (sent as the x-api-key header).
# Webhook URL to enter in Shiprocket: https://your-domain.com/api/logistics/events
SHIPROCKET_WEBHOOK_TOKEN=
# Bearer/x-api-key token protecting the background job runner (POST/GET /api/shiprocket/jobs/run).
# Point an external scheduler (Vercel Cron, cron-job.org) at that endpoint every few minutes.
SHIPROCKET_CRON_TOKEN=





# Cron job authorization secret for automated background tasks (e.g. 60-day product trash retention purge)
# Point an external cron service (Vercel Cron, GitHub Actions, cron-job.org) at /api/orycms/cron/purge-trash
# with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=