# NeonDB pooled connections (application runtime)
DATABASE_URL=
ORYCMS_DATABASE_URL=

# NeonDB direct/non-pooler connection (Prisma migrations only)
# Use the Neon hostname without "-pooler" and set sslmode=verify-full.
DIRECT_DATABASE_URL=

# Next.js public URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Storefront footer company details
NEXT_PUBLIC_COMPANY_EMAIL=support@adhunikcropcare.com
NEXT_PUBLIC_COMPANY_PHONE=+919205762766
NEXT_PUBLIC_COMPANY_ADDRESS=India

# Storefront footer social media links (leave blank to hide a platform)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Storefront customer authentication (required in production)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STOREFRONT_AUTH_SECRET=

# Sentry — DSN (public key safe to expose in client bundles)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Sentry — source map upload (get these from sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudnary — get these from cloudinary.com → Settings → Upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ORYCMS_FOLDER=

# Razorpay — get these from razorpay.com → Settings → API Keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STOCK_RESERVATION_MINUTES=

# Razorpay — test keys (for development only)
RAZORPAY_KEY_ID=..
RAZORPAY_KEY_SECRET=..
RAZORPAY_WEBHOOK_SECRET=..
STOCK_RESERVATION_MINUTES=..

# Optional email sending via Resend
RESEND_API_KEY=...
ORDER_EMAIL_FROM=orders@yourdomain.com

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
SMTP_GMAIL_USER=
SMTP_GMAIL_APP_PASSWORD=
SMTP_EMAIL_FROM=
SMTP_ADMIN_EMAIL=
EMAIL_UNSUBSCRIBE_SECRET=

# Shiprocket shipping integration
# API credentials (email + password) are entered in OryCMS → Settings → Shiprocket
# and stored encrypted in the database. These env vars cover encryption + webhook auth only.
# Generate the key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SHIPROCKET_ENCRYPTION_KEY=
# Shared secret set as the webhook token in the Shiprocket dashboard (sent as the x-api-key header).
SHIPROCKET_WEBHOOK_TOKEN=
# Bearer/x-api-key token protecting the background job runner (POST/GET /api/shiprocket/jobs/run).
# Point an external scheduler (Vercel Cron, cron-job.org) at that endpoint every few minutes.
SHIPROCKET_CRON_TOKEN=
